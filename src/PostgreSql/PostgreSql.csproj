<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Visitors\**" />
    <Compile Remove="Writers\**" />
    <EmbeddedResource Remove="Visitors\**" />
    <EmbeddedResource Remove="Writers\**" />
    <None Remove="Visitors\**" />
    <None Remove="Writers\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PostgreSqlParser.cs" />
    <Compile Remove="PostgreSqlWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="PostgresParser.g4">
      <Package>PostgreSql</Package>
      <Listener>False</Listener>
      <Visitor>True</Visitor>
      <Error>True</Error>
    </Antlr4>
    <Antlr4 Include="PostgresLexer.g4">
      <Package>PostgreSql</Package>
      <Listener>False</Listener>
      <Visitor>True</Visitor>
      <Error>True</Error>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tradurre\Tradurre.csproj" />
  </ItemGroup>

</Project>